# Keep deploys lean.
#
# NOTE: `remotion/` must ship. The dashboard imports the composition to render
# the live preview in the browser, so excluding it breaks the build with
# "Can't resolve @/remotion/SampleClip". Only the worker-side pieces are cut.
scripts
remotion.config.ts
# The demo source assets (song, art) are render inputs and stay local, but
# the rendered demo clips are the homepage's proof — they must ship.
public/demo/*
!public/demo/clips
out
