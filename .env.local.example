# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase Dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret key (service_role) — server only, never shipped to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY

# Publishable key (anon) — safe in the browser, required for sign-in
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional: shown on the clip end card, and used for magic-link redirects
NEXT_PUBLIC_SITE_URL=

# Optional: enables REAL lyric alignment. Without one, lyric timing is
# estimated from syllable counts. Set either (worker-side only).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Notes:
# - Without the URL + secret key, the app runs in demo mode: forms succeed
#   but nothing is persisted.
# - Without the publishable key, sign-in is disabled with a clear message;
#   the rest of the site keeps working.
