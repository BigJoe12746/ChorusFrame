# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase Dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret key (service_role) — server only, never shipped to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY

# Publishable key (anon) — safe in the browser, required for sign-in
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# REQUIRED before launch: the public contact for legal pages, DMCA notices,
# deletion requests, and the share pages' "Report this clip" link. Until it's
# set, the live site shows a placeholder address that reaches no one.
NEXT_PUBLIC_LEGAL_CONTACT=

# Optional: shown on the clip end card, and used for magic-link redirects
NEXT_PUBLIC_SITE_URL=

# Optional: enables REAL lyric alignment. Without one, lyric timing is
# estimated from syllable counts. Set either (worker-side only).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Optional: emails the artist when their clips finish. Without one, the worker
# logs what it would have sent. Set either (worker-side only).
RESEND_API_KEY=
POSTMARK_TOKEN=
# Verified sender, e.g. "ChorusFrame <clips@yourdomain.com>"
NOTIFY_FROM=

# Notes:
# - Without the URL + secret key, the app runs in demo mode: forms succeed
#   but nothing is persisted.
# - Without the publishable key, sign-in is disabled with a clear message;
#   the rest of the site keeps working.

# Optional: switches on Pro checkout. Without these the billing tab explains
# that checkout is not live yet, and nothing can be charged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
